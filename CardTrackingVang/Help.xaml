<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Header="clr-namespace:CardTrackingVang.Header"
             xmlns:Vang="clr-namespace:CardTrackingVang.CustomControls"
             x:Class="CardTrackingVang.Help"
             Title="Help"
             Style="{StaticResource MobileMargining}">

    <ScrollView>

        <VerticalStackLayout Spacing="20"
                             Padding="20"
                             MaximumWidthRequest="600"
                             HorizontalOptions="Center">
            <VerticalStackLayout.Resources>
                <Style TargetType="VerticalStackLayout">
                    <Setter Property="Spacing" Value="8"/>
                </Style>
            </VerticalStackLayout.Resources>

            <Header:HeaderApp />

            <!-- Page Title -->
            <Label Text="Help and Documentation"
                   Style="{StaticResource TitleLabelStyling}"
                   HorizontalOptions="Center"
                   FontSize="22" />

            <!-- SECTION TEMPLATE STYLE (visual hierarchy shift) -->

            <!-- Viewing -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="Viewing your collection"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Home page lists your cards, tap on a card (twice on mobile, once on desktop) to see details"></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="Use header buttons to navigate pages"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- Add Card -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="Adding a card"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Open Add Card, enter details, then tap add to collection"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- Analyze -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="Analyzing a card"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Use a high-resolution image with minimal background"></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="If data is not being recognize by the AI please share image and put an issue on github"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- GPS -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="GPS coordinates"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Ensure location permissons are enabled"></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="Map marker shows Coulee Cards and Gaming in Wausau"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- PokeAPI -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="PokeAPI"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Catch a random pokemon and add it to your collection!"></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="Using the PokeAPI requires an Internet connection along with HTTPS support"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- Editing -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="Editing and Deleting"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Edit card details from the card details page this can be accessed by double tapping the card on mobile and once on desktio."></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="Go into card details and select 'Delete Card' to remove a card"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

            <!-- Troubleshooting -->
            <Border Style="{StaticResource CardDetailsBorder}">
                <VerticalStackLayout>
                    <Vang:HelpLabel Text="Troubleshooting"></Vang:HelpLabel>
                    <Vang:HelpInfoLabel Text="Restart app if data does not load properly"></Vang:HelpInfoLabel>
                    <Vang:HelpInfoLabel Text="Please put in an issue on github of any issues"></Vang:HelpInfoLabel>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>