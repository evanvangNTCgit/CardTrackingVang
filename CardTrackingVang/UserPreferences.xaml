<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Header="clr-namespace:CardTrackingVang.Header"
             xmlns:Vang="clr-namespace:CardTrackingVang.CustomControls"
             x:Class="CardTrackingVang.UserPreferences"
             Title="UserPreferences"
             Style="{StaticResource MobileMargining}">

    <ScrollView>

        <VerticalStackLayout
                             HorizontalOptions="Center"
                             MaximumWidthRequest="500">

            <Header:HeaderApp />

            <!-- Title -->
            <Label Text="User Preferences"
                   Style="{StaticResource TitleLabelStyling}"
                   HorizontalOptions="Center"
                   FontSize="22" />

            <!-- Settings Card -->
            <Border Style="{StaticResource CardDetailsBorder}">

                <VerticalStackLayout Spacing="15">

                    <!-- Setting Row -->
                    <HorizontalStackLayout Spacing="15"
                                           VerticalOptions="Center">

                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Center">
                            <Vang:PreferenceHeadLabel Text="Theme"/>
                            <Vang:PreferenceInfoLabel Text="Toggle light / dark mode"/>
                        </VerticalStackLayout>

                        <Switch x:Name="UserThemeToggle"
                                Toggled="UserThemeToggle_Toggled"
                                HorizontalOptions="End" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Settings Card -->
            <Border Style="{StaticResource CardDetailsBorder}">

                <VerticalStackLayout Spacing="15">

                    <!-- Setting Row -->
                    <HorizontalStackLayout Spacing="15"
                                           VerticalOptions="Center">

                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Center">

                            <Vang:PreferenceHeadLabel Text="Animations"/>
                            <Vang:PreferenceInfoLabel Text="Toggle Animations on / off" />
                        </VerticalStackLayout>
                        <Switch x:Name="AnimationsToggle" HorizontalOptions="End" Toggled="AnimationsToggle_Toggled"/>
                        <Vang:PreferenceInfoLabel x:Name="AnimationsIsToggled"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>